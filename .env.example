# 后端配置示例：复制为 .env 或直接 export 后再启动。
# 只放占位值，真实密钥不要提交到仓库。

# --- 数据库 ---
# 本地默认使用 H2（MySQL 兼容模式），数据文件在 backend/data/
# 切换到 MySQL 时把下面三行指向真实库即可，Flyway 会自动建表。
# DB_URL=jdbc:mysql://localhost:3306/github_look?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
# DB_USERNAME=github_look
# DB_PASSWORD=change-me
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# --- Redis（幂等去重 + 事件队列 + 统计缓存）---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Webhook ---
# 全局默认 Secret，仓库未单独配置时使用；GitHub 上填同一个值。
GITHUB_WEBHOOK_SECRET=hanin-github
WEBHOOK_AUTO_REGISTER=true
# 设置页展示给用户复制的公网地址（可换成 ngrok / 反向代理域名）
PUBLIC_BASE_URL=http://123.56.106.44:8188

# --- 安全 ---
# 至少 32 个字符；生产环境务必替换
APP_JWT_SECRET=dev-only-secret-please-override-with-32bytes-minimum
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 「设置与接入」页的二次验证密码（与登录密码独立，同样通过环境变量注入）
SETTINGS_ACCESS_PASSWORD=settings123
# 解锁有效期，到期后需重新输入
SETTINGS_TOKEN_TTL=PT30M
# HTTPS 部署时设为 true（Cookie 只在加密连接发送）
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- GitHub API（可选）---
# 配置后启用：重新运行 / 取消运行。留空则相关按钮置灰，接口返回 503。
# PAT 需要 Actions:write（重跑/取消），只读场景给 Actions:read 即可。
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- 其它 ---
SERVER_PORT=8080
APP_ZONE=Asia/Shanghai
QUEUE_CONSUMERS=8
DEMO_DATA_ENABLED=true
LOG_LEVEL=INFO
