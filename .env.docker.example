# Docker Compose 部署环境变量
# 用法： cp .env.docker.example .env  →  修改下面所有 change-me  →  docker compose up -d --build

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=github_look
MYSQL_USER=githublook
MYSQL_PASSWORD=change-me-db-password
DB_POOL_SIZE=10

# ---------- Redis ----------
# 走内网容器网络，默认不设密码；如需开启，同时给 redis 加 --requirepass
REDIS_PASSWORD=

# ---------- Webhook ----------
# 必须与 GitHub 仓库 Webhook 里填的 Secret 完全一致
GITHUB_WEBHOOK_SECRET=hanin-github
# 生产建议 false：未知仓库不允许自动注册（自动注册依赖全局 Secret，安全性更弱）
WEBHOOK_AUTO_REGISTER=false
# 公网访问地址，设置页会把它拼成 Payload URL 展示给用户
PUBLIC_BASE_URL=http://your-server-ip-or-domain

# ---------- 登录与设置页门禁 ----------
# 用 openssl rand -hex 32 生成
APP_JWT_SECRET=change-me-32-bytes-min
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# 「设置与接入」页的二次验证密码（与登录密码独立）
SETTINGS_ACCESS_PASSWORD=change-me-settings-password
# 解锁有效期，默认 30 分钟
SETTINGS_TOKEN_TTL=PT30M

# 用 HTTPS 时改成 true，Cookie 只在加密连接发送
COOKIE_SECURE=false
# 前端与 API 同域时用当前域名即可
ALLOWED_ORIGINS=http://your-server-ip-or-domain

# ---------- GitHub API（可选）----------
# 配置后解锁「重新运行 / 取消运行」；需要 Actions: write
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ---------- 运行参数 ----------
# 生产环境不要灌演示数据
DEMO_DATA_ENABLED=false
QUEUE_CONSUMERS=8
APP_ZONE=Asia/Shanghai
LOG_LEVEL=INFO

# 宿主机映射端口（80 被占用时改成 8080 等）
WEB_PORT=80
