# 复制为 .env 后逐项填写： cp .env.example .env
# 注意：docker compose 会自动读取同目录的 .env

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=github_look
MYSQL_USER=githublook
MYSQL_PASSWORD=change-me-db
# 连接池：与 QUEUE_CONSUMERS 对齐（消费者数 <= 连接数）
DB_POOL_SIZE=16

# ---------- Redis ----------
# 容器内网访问，默认不设密码
REDIS_PASSWORD=

# ---------- Webhook ----------
GITHUB_WEBHOOK_SECRET=hanin-github
WEBHOOK_AUTO_REGISTER=false
# 必须是浏览器和 GitHub 都能访问的地址
PUBLIC_BASE_URL=http://123.56.106.44:8188

# ---------- 登录与设置页门禁 ----------
# openssl rand -hex 32
APP_JWT_SECRET=change-me-32-bytes-minimum
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-login-password
SETTINGS_ACCESS_PASSWORD=change-me-settings-password
SETTINGS_TOKEN_TTL=PT30M

# HTTP 部署必须 false；上 HTTPS 后改 true
COOKIE_SECURE=false
# 与浏览器地址一致（协议+IP/域名+端口）
ALLOWED_ORIGINS=http://123.56.106.44:8188

# ---------- GitHub API（可选）----------
# 配了才能用「重新运行 / 取消运行」，需要 Actions:write
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ---------- 运行参数 ----------
DEMO_DATA_ENABLED=false
# 队列消费者数（虚拟线程，单条几 KB，扩到 16 几乎无额外成本）
# 注意：必须 <= DB_POOL_SIZE，否则线程会阻塞在连接池上，扩了也没用
QUEUE_CONSUMERS=16
APP_ZONE=Asia/Shanghai
LOG_LEVEL=INFO

# ---------- 端口 ----------
# 宿主机对外端口
WEB_PORT=8188

# ---------- JVM ----------
# 2C2G 用默认值；4G+ 可改成 -Xms384m -Xmx768m
JAVA_OPTS=-Xms192m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai
