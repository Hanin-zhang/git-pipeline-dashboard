# GitHub Look 裸机部署环境变量
# 位置：/opt/github-look/.env    权限：chmod 600
# 格式：KEY=value（systemd EnvironmentFile 语法，不要写 export）

# ---------- 数据库 ----------
DB_URL=jdbc:mysql://127.0.0.1:3306/github_look?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
DB_USERNAME=githublook
DB_PASSWORD=改成你的数据库密码
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_POOL_SIZE=5

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 若 redis.conf 里设了 requirepass，这里填同一个值
REDIS_PASSWORD=

# ---------- Webhook ----------
# 必须与 GitHub 仓库 Webhook 里的 Secret 完全一致
GITHUB_WEBHOOK_SECRET=hanin-github
# 生产建议 false：未知仓库不允许自动注册
WEBHOOK_AUTO_REGISTER=false
# 设置页展示的 Payload URL 前缀，必须是你真实可访问的公网地址
PUBLIC_BASE_URL=http://123.56.106.44:8188

# ---------- 登录与设置页门禁 ----------
# 生成命令：openssl rand -hex 32
APP_JWT_SECRET=改成32位以上随机串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=改成你的登录密码
# 「设置与接入」页的二次验证密码（与登录密码独立）
SETTINGS_ACCESS_PASSWORD=改成你的设置页密码
SETTINGS_TOKEN_TTL=PT30M

# 纯 HTTP 部署必须是 false；上 HTTPS 后改 true
COOKIE_SECURE=false
# 与浏览器访问地址一致（协议 + IP/域名 + 端口）
ALLOWED_ORIGINS=http://123.56.106.44:8188

# ---------- GitHub API（可选）----------
# 配置后才能用「重新运行 / 取消运行」，需要 Actions:write
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ---------- 运行参数 ----------
DEMO_DATA_ENABLED=false
QUEUE_CONSUMERS=4
APP_ZONE=Asia/Shanghai
LOG_LEVEL=INFO

# ---------- JVM ----------
# 2C2G 服务器用这套；4G 以上可改为 -Xms384m -Xmx768m
JAVA_OPTS=-Xms192m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai
